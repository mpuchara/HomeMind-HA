+def controllable_context_exclusions(state_map, registry):
+    """Return all context entities that belong to currently controllable devices.
+
+    The exclusion is intentionally global: if any entity is a supported control target,
+    that entity and every Entity Registry sibling on the same physical device are removed
+    from the candidate input pool of *every* agent. Device-less HA helpers are excluded
+    directly when they are controllable. This prevents policies from learning actuator-to-
+    actuator shortcuts (for example one light predicting another light) instead of causal
+    environmental signals.
+    """
+    registry = registry or {}
+    controllable_entities = set()
+    controllable_devices = set()
+    for eid, st in (state_map or {}).items():
+        try:
+            is_controllable = bool(target_options_for_state(st))
+        except Exception:
+            is_controllable = False
+        if not is_controllable:
+            continue
+        controllable_entities.add(eid)
+        device_id = (registry.get(eid) or {}).get("device_id")
+        if device_id:
+            controllable_devices.add(device_id)
+
+    excluded = set(controllable_entities)
+    if controllable_devices:
+        for eid, reg in registry.items():
+            if (reg or {}).get("device_id") in controllable_devices:
+                excluded.add(eid)
+    return excluded, {
+        "detected_controllable_entities": len(controllable_entities),
+        "detected_controllable_devices": len(controllable_devices),
+        "excluded_controllable_context_entities": len(excluded),
+    }
+
+
