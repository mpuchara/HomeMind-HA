 def context_scalar(entity_id, state, agent=None):
     """Scalar used in an explicit entity slot.
 
-    For the controlled entity, represent the controlled property itself (brightness,
-    setpoint, cover position, etc.) instead of only the HA domain state such as ``on``
-    or ``heat``. This makes the policy aware of its current actuator position and its
-    temporal deltas. Other entities use their HA state, which is also what the imported
-    low-impact Recorder context contains reliably.
+    v0.7.4 never feeds a directly controllable Home Assistant entity into an agent.
+    This is a hard safety guard in addition to context selection, so an old/stale schema
+    cannot accidentally reintroduce another actuator as an input. Device-sibling entities
+    are filtered by the Entity Registry in ``controllable_context_exclusions``.
     """
     if state is None:
         return None
-    if agent and entity_id == agent.get("target_entity"):
-        try:
-            value = target_value(state, agent.get("target_property"))
-            if value is not None:
-                lo = float(agent.get("min_value", 0.0)); hi = float(agent.get("max_value", 1.0))
-                if hi > lo:
-                    return clamp(2.0 * (float(value) - lo) / (hi - lo) - 1.0, -1.0, 1.0)
-        except Exception:
-            pass
+    try:
+        if target_options_for_state(state):
+            return None
+    except Exception:
+        pass
     return state_scalar(state)
 
 
